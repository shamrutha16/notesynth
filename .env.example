OPENAI_API_KEY=sk-your-openai-key-here

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.2

WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

CHUNK_SIZE=400
CHUNK_OVERLAP=80

RETRIEVAL_TOP_K=8
USE_HYDE=false

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=500
CHROMA_PERSIST_DIR=./chroma_db

REDIS_URL=redis://localhost:6379/0
